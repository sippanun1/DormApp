generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model audit_log {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entity_type String
  entity_id   String?  @db.Uuid
  action      String
  detail      Json?
  actor_id    String   @db.Uuid
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  users       users    @relation(fields: [actor_id], references: [id], onUpdate: NoAction)

  @@index([created_at(sort: Desc)], map: "idx_audit_log_created")
  @@index([entity_type, entity_id], map: "idx_audit_log_entity")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This table contains exclusion constraints and requires additional setup for migrations. Visit https://pris.ly/d/exclusion-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model bookings {
  id                   String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  room_id              String               @db.Uuid
  tenant_id            String               @db.Uuid
  check_in_date        DateTime             @db.Date
  check_out_date       DateTime             @db.Date
  nightly_rate         Decimal              @db.Decimal(10, 2)
  status               String               @default("confirmed")
  created_by           String               @db.Uuid
  created_at           DateTime             @default(now()) @db.Timestamptz(6)
  key_deposit          Decimal              @default(0) @db.Decimal(10, 2)
  key_deposit_refunded Boolean              @default(false)
  rate_overridden      Boolean              @default(false)
  key_deposit_deducted Decimal              @default(0) @db.Decimal(10, 2)
  users                users                @relation(fields: [created_by], references: [id], onUpdate: NoAction)
  rooms                rooms                @relation(fields: [room_id], references: [id], onUpdate: NoAction)
  tenants              tenants              @relation(fields: [tenant_id], references: [id], onUpdate: NoAction)
  guest_registrations  guest_registrations?

  @@index([check_in_date, check_out_date], map: "idx_bookings_dates")
  @@index([room_id], map: "idx_bookings_room")
  @@index([tenant_id], map: "idx_bookings_tenant")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model buildings {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  address   String?
  is_active Boolean @default(true)
  rooms     rooms[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model guest_registrations {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  booking_id        String   @unique @db.Uuid
  guest_nationality String
  guest_id_type     String
  guest_id_number   String
  guest_address     String
  registered_at     DateTime @default(now()) @db.Timestamptz(6)
  bookings          bookings @relation(fields: [booking_id], references: [id], onUpdate: NoAction)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model invoice_status_history {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invoice_id String   @db.Uuid
  old_status String
  new_status String
  reason     String?
  changed_by String   @db.Uuid
  changed_at DateTime @default(now()) @db.Timestamptz(6)
  users      users    @relation(fields: [changed_by], references: [id], onUpdate: NoAction)
  invoices   invoices @relation(fields: [invoice_id], references: [id], onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model invoices {
  id                     String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invoice_number         BigInt                   @unique @default(autoincrement())
  tenancy_id             String                   @db.Uuid
  billing_period         DateTime                 @db.Date
  room_charge            Decimal                  @default(0) @db.Decimal(10, 2)
  utility_charge         Decimal                  @default(0) @db.Decimal(10, 2)
  other_charges          Decimal                  @default(0) @db.Decimal(10, 2)
  late_fee_frozen        Decimal?                 @db.Decimal(10, 2)
  total_amount           Decimal                  @db.Decimal(10, 2)
  due_date               DateTime                 @db.Date
  status                 String                   @default("unpaid")
  generated_by           String                   @db.Uuid
  generated_at           DateTime                 @default(now()) @db.Timestamptz(6)
  invoice_status_history invoice_status_history[]
  users                  users                    @relation(fields: [generated_by], references: [id], onUpdate: NoAction)
  tenancies              tenancies                @relation(fields: [tenancy_id], references: [id], onUpdate: NoAction)
  payments               payments[]

  @@unique([tenancy_id, billing_period])
  @@index([status], map: "idx_invoices_status")
  @@index([tenancy_id], map: "idx_invoices_tenancy")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model meter_reading_corrections {
  id                    String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  meter_reading_id      String         @db.Uuid
  corrected_old_reading Decimal        @db.Decimal(10, 2)
  corrected_new_reading Decimal        @db.Decimal(10, 2)
  reason                String
  corrected_by          String         @db.Uuid
  corrected_at          DateTime       @default(now()) @db.Timestamptz(6)
  users                 users          @relation(fields: [corrected_by], references: [id], onUpdate: NoAction)
  meter_readings        meter_readings @relation(fields: [meter_reading_id], references: [id], onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model meter_readings {
  id                        String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenancy_id                String                      @db.Uuid
  meter_type                String
  reading_period            DateTime                    @db.Date
  old_reading               Decimal                     @db.Decimal(10, 2)
  new_reading               Decimal                     @db.Decimal(10, 2)
  rate                      Decimal                     @db.Decimal(10, 4)
  computed_cost             Decimal?                    @default(dbgenerated("((new_reading - old_reading) * rate)")) @db.Decimal(10, 2)
  entered_by                String                      @db.Uuid
  entered_at                DateTime                    @default(now()) @db.Timestamptz(6)
  room_id                   String?                     @db.Uuid
  is_estimated              Boolean                     @default(false)
  meter_reading_corrections meter_reading_corrections[]
  users                     users                       @relation(fields: [entered_by], references: [id], onUpdate: NoAction)
  rooms                     rooms?                      @relation(fields: [room_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  tenancies                 tenancies                   @relation(fields: [tenancy_id], references: [id], onUpdate: NoAction)

  @@unique([tenancy_id, meter_type, reading_period, room_id], map: "uq_meter_readings_period")
  @@index([tenancy_id, reading_period, meter_type], map: "idx_meter_readings_lookup")
  @@index([room_id, reading_period], map: "idx_meter_readings_room")
  @@index([tenancy_id], map: "idx_meter_readings_tenancy")
}

