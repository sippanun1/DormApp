  tenancies            tenancies?             @relation("tenanciesTotenancies", fields: [previous_tenancy_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  other_tenancies      tenancies[]            @relation("tenanciesTotenancies")
  rooms                rooms                  @relation(fields: [room_id], references: [id], onUpdate: NoAction)
  tenants              tenants                @relation(fields: [tenant_id], references: [id], onUpdate: NoAction)
  tenancy_room_history tenancy_room_history[]

  @@index([room_id], map: "idx_tenancies_room")
  @@index([tenant_id], map: "idx_tenancies_tenant")
}

