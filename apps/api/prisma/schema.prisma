/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model deposit_settlements {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenancy_id         String    @unique @db.Uuid
  deposit_amount     Decimal   @db.Decimal(10, 2)
  cleaning_fee       Decimal   @default(0) @db.Decimal(10, 2)
  damage_amount      Decimal   @default(0) @db.Decimal(10, 2)
  outstanding_amount Decimal   @default(0) @db.Decimal(10, 2)
  deposit_forfeited  Boolean   @default(false)
  forfeit_reason     String?
  refund_amount      Decimal   @default(dbgenerated("\nCASE\n    WHEN deposit_forfeited THEN (0)::numeric\n    ELSE GREATEST((((deposit_amount - cleaning_fee) - damage_amount) - outstanding_amount), (0)::numeric)\nEND")) @db.Decimal(10, 2)
  excess_waived      Decimal   @default(dbgenerated("\nCASE\n    WHEN deposit_forfeited THEN (0)::numeric\n    ELSE GREATEST((((cleaning_fee + damage_amount) + outstanding_amount) - deposit_amount), (0)::numeric)\nEND")) @db.Decimal(10, 2)
  notes              String?
  settled_by         String    @db.Uuid
  settled_at         DateTime  @default(now()) @db.Timestamptz(6)
  users              users     @relation(fields: [settled_by], references: [id], onUpdate: NoAction)
  tenancies          tenancies @relation(fields: [tenancy_id], references: [id], onUpdate: NoAction)

  @@index([tenancy_id], map: "idx_deposit_settlements_tenancy")
}

