# ============================================================
# Amanew — environment template
#
# Copy to .env and fill in real values. NEVER commit .env.
# Master Document §18 / ADR-020 for where each value comes from.
# ============================================================

# --- Database -------------------------------------------------
# Supabase → Project Settings → Database → Connection string (URI).
# Use the POOLED connection (port 6543) for the app; the direct
# connection (5432) is for migrations only.
DATABASE_URL=
DIRECT_URL=

# --- Supabase -------------------------------------------------
# Project Settings → API Keys. Supabase renamed both keys in 2025:
#   publishable (sb_publishable_…) is the old "anon" key
#   secret      (sb_secret_…)      is the old "service_role" key
# Either naming works; fill whichever pair the dashboard shows you.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# The secret key bypasses every check. Express only — it must never reach the
# Next.js client bundle, which is why it is NOT prefixed NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Legacy names, still accepted. Leave blank if you filled the two above.
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# --- Auth -----------------------------------------------------
# THIS IS OURS, NOT SUPABASE'S. It signs the staff/tenant login tokens this
# app issues; it is unrelated to Supabase's own JWT secret and is not copied
# from any dashboard. Generate a fresh one and never reuse it elsewhere:
#   openssl rand -base64 48
JWT_SECRET=
# Shift-length, not 30 days: reception is a shared desk.
JWT_EXPIRES_IN=10h
# Tenants, not staff: a tenant cannot re-authenticate on their own — the only
# way to get another session is a new code from the office — so a shift-length
# expiry would lock them out of their own bills overnight.
TENANT_JWT_EXPIRES_IN=30d
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_MIN=15

# --- Uploads --------------------------------------------------
# 5MB, per §5's slip constraint. Enforced server-side by byte
# sniffing, not by the client-declared MIME type.
UPLOAD_MAX_SIZE=5242880
SLIP_BUCKET=slips

# --- Runtime --------------------------------------------------
# Not cosmetic: late fees start on the 6th and freeze into the
# invoice (ADR-009). A UTC service bills ฿50 early, permanently.
TZ=Asia/Bangkok
NODE_ENV=development
PORT=3001
# The one origin the API accepts browser calls from (CORS). Locally the Next
# dev server; in production the Vercel URL — set it there, or the browser
# blocks every request the deployed frontend makes.
WEB_ORIGIN=http://localhost:3000

# --- Frontend -------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1

# --- Phase 2 (leave blank in Phase 1) -------------------------
# Phase 3, from ONE Messaging API channel. No LIFF id and no login channel id:
# LINE carries notifications only and is never how a tenant signs in
# (docs/LINE_INTEGRATION_PLAN.md, correction 2026-08-21).
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# The free tier's monthly push allowance. Over it, a notification is `skipped`
# and recorded — never retried, never failed.
LINE_MONTHLY_PUSH_CAP=300
# 1 = build the message and log it, send nothing. Defaults ON everywhere except
# NODE_ENV=production, so a test run cannot reach a real tenant's phone.
LINE_DRY_RUN=
# How often the queue drains. The push never happens in a request path.
LINE_SEND_INTERVAL_SEC=60
PROMPTPAY_ID=
